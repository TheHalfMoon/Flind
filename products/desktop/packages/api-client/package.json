{
  "name": "@flind/api-client",
  "version": "1.0.0",
  "description": "Client for the Flind API (auth, projects, task metadata and billing). Pure HTTPS, runs in any JavaScript environment; factory-created with no DI container.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node ../../scripts/rimraf.mjs .turbo",
    "generate-client": "tsx scripts/update-openapi-client.ts"
  },
  "devDependencies": {
    "@flind/tsconfig": "workspace:*",
    "prettier": "3.8.1",
    "tsx": "^4.22.3",
    "typed-openapi": "2.2.7",
    "typescript": "catalog:",
    "vitest": "^4.1.8"
  },
  "files": [
    "src/**/*"
  ],
  "dependencies": {
    "@flind/shared": "workspace:*",
    "zod": "^4.1.12"
  }
}
