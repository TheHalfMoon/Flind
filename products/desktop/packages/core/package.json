{
  "name": "@flind/core",
  "version": "1.0.0",
  "description": "Host-agnostic business layer. Domain types, schemas, pure functions, and orchestration services that consume @flind/platform capability interfaces via Inversify constructor injection. No I/O implementation, no Electron/Node host syscalls, no UI. Runs anywhere the platform interfaces are bound (desktop, web, mobile, cloud).",
  "private": true,
  "type": "module",
  "exports": {
    "./*": [
      "./src/*.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node ../../scripts/rimraf.mjs .turbo"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.22.1",
    "@modelcontextprotocol/ext-apps": "^1.1.2",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@pierre/diffs": "^1.2.10",
    "@flind/agent": "link:../../../../packages/agent/packages/agent",
    "@flind/api-client": "workspace:*",
    "@flind/di": "workspace:*",
    "@flind/platform": "workspace:*",
    "@flind/shared": "workspace:*",
    "@flind/workspace-client": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "fuse.js": "^7.1.0",
    "immer": "^11.1.3",
    "inversify": "catalog:",
    "reflect-metadata": "catalog:",
    "yaml": "^2.9.0",
    "zod": "^4.1.12",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@flind/tsconfig": "workspace:*",
    "typescript": "catalog:",
    "vitest": "^4.1.8"
  },
  "files": [
    "src/**/*"
  ]
}
