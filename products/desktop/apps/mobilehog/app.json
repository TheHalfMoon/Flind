{
  "expo": {
    "name": "Flind Studio",
    "slug": "flind-studio",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "flind-studio",
    "icon": "./assets/app-icon.png",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thehalfmoon.flind.studio",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.thehalfmoon.flind.studio"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Flind Studio to attach photos to your tasks"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Flind Studio to use the microphone for dictation.",
          "speechRecognitionPermission": "Allow Flind Studio to turn speech into a message draft."
        }
      ],
      "./plugins/withSceneLifecycle",
      "./plugins/withPodfileResourceBundleFix",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/JetBrainsMono-Regular.ttf",
              "./assets/fonts/JetBrainsMono-Medium.ttf"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logomark.png"
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logomark.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 160
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-updates"
    ],
    "extra": {
      "router": {}
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    }
  }
}
