# Flind mobile analytics: no telemetry destination or token is configured by default.
# Set both values only for a Flind-owned instance you operate.
EXPO_PUBLIC_FLIND_ANALYTICS_API_KEY=
EXPO_PUBLIC_FLIND_ANALYTICS_HOST=


# Explicit Flind API and OAuth configuration. Leave unset to disable hosted login;
# never reuse upstream service URLs or OAuth client registrations.
EXPO_PUBLIC_FLIND_API_US_URL=
EXPO_PUBLIC_FLIND_API_EU_URL=
EXPO_PUBLIC_FLIND_API_DEV_URL=http://localhost:8010
EXPO_PUBLIC_FLIND_OAUTH_US_CLIENT_ID=
EXPO_PUBLIC_FLIND_OAUTH_EU_CLIENT_ID=
EXPO_PUBLIC_FLIND_OAUTH_DEV_CLIENT_ID=
