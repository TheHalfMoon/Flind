{
    "providerId": "flind.example",
    "providerName": "Flind",
    "serviceId": "reverse-proxy-us",
    "serviceName": "Flind Managed Reverse Proxy (US)",
    "version": 1,
    "syncBlock": false,
    "logoUrl": "https://flind.example/flind-logo.svg",
    "description": "Configures a CNAME record for Flind managed reverse proxy",
    "variableDescription": "target: CNAME target generated by Flind.",
    "syncPubKeyDomain": "domainconnect.flind.example",
    "syncRedirectDomain": "us.flind.example",
    "hostRequired": true,
    "records": [
        {
            "type": "CNAME",
            "host": "@",
            "pointsTo": "%target%",
            "ttl": 3600
        }
    ]
}
