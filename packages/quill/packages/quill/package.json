{
    "name": "@flind/quill",
    "private": true,
    "version": "0.3.0-beta.16",
    "description": "Flind design system primitives, components and Tailwind v4 blocks",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/TheHalfMoon/Flind.git",
        "directory": "packages/quill/packages/quill"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        },
        "./tailwind.css": "./dist/tailwind.css",
        "./base.css": "./dist/base.css",
        "./primitives.css": "./dist/primitives.css",
        "./tokens.css": "./dist/tokens.css",
        "./color-system.css": "./dist/color-system.css",
        "./tokens.scoped.css": "./dist/tokens.scoped.css",
        "./base.scoped.css": "./dist/base.scoped.css",
        "./color-system.scoped.css": "./dist/color-system.scoped.css",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsx scripts/build-css.ts && vite build",
        "build:css": "tsx scripts/build-css.ts",
        "build:js": "vite build"
    },
    "dependencies": {
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.577.0",
        "react-resizable-panels": "^4.7.1",
        "tailwind-merge": "^2.2.2"
    },
    "devDependencies": {
        "@base-ui/react": "catalog:",
        "@flind/quill-blocks": "workspace:*",
        "@flind/quill-components": "workspace:*",
        "@flind/quill-primitives": "workspace:*",
        "@flind/quill-tokens": "workspace:*",
        "@types/react": "catalog:",
        "tsx": "^4.19.0",
        "vite": "catalog:",
        "vite-plugin-dts": "^4.5.4"
    },
    "peerDependencies": {
        "@base-ui/react": "^1.4.0",
        "react": "^18.3.1 || ^19.0.0",
        "react-dom": "^18.3.1 || ^19.0.0",
        "tailwindcss": "^4.0.0"
    },
    "engines": {
        "node": ">=20"
    }
}
