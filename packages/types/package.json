{
  "name": "@flind/types",
  "version": "1.421.0",
  "bugs": {
    "url": "https://github.com/TheHalfMoon/Flind/issues"
  },
  "description": "Private staged Flind SDK types compatibility package; not published",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheHalfMoon/Flind.git",
    "directory": "packages/types"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "UPSTREAM_PACKAGE.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "devDependencies": {
    "@rslib/core": "0.23.2",
    "typescript": "7.0.2",
    "vitest": "^1.6.1",
    "typescript-legacy": "npm:typescript@5.8.2",
    "@posthog-tooling/tsconfig-base": "1.1.1"
  },
  "scripts": {
    "check-types": "tsc --noEmit --project tsconfig.build.json",
    "clean": "rimraf dist",
    "lint": "oxlint --report-unused-disable-directives-severity error src",
    "lint:fix": "oxlint --report-unused-disable-directives-severity error src --fix",
    "build": "rslib build",
    "dev": "rslib build -w",
    "test:unit": "vitest run",
    "package": "pnpm pack --out $PACKAGE_DEST/%s.tgz"
  },
  "private": true
}
