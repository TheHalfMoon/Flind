#!/bin/bash

TURBO_PATH=./node_modules/.bin/turbo

# if turbo is not installed, install the workspace root, which provides it
if [ ! -f $TURBO_PATH ] && [ ! -f ./node_modules/turbo/bin/turbo ]; then
  pnpm -w --filter=@flind/root install
fi

# pnpm 11 can install turbo without linking its bin; call the installed entry point instead
if [ ! -f $TURBO_PATH ]; then
  TURBO_PATH="node ./node_modules/turbo/bin/turbo"
fi

# run turbo with the cli arguments
$TURBO_PATH "$@"
